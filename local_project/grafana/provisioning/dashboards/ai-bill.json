  "panels": [
    {"id":1,"type":"timeseries","title":"Cost by team","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"targets":[{"format":"time_series","rawQuery":true,"rawSql":"SELECT window_start AS time, team_id, SUM(cost) AS cost FROM serving.merged_view WHERE $__timeFilter(window_start) GROUP BY window_start, team_id ORDER BY window_start"}]},
    {"id":2,"type":"bargauge","title":"Tokens by model","gridPos":{"x":12,"y":0,"w":6,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"short"}},"options":{"orientation":"horizontal","displayMode":"gradient"},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT model, SUM(tokens_in + tokens_out) AS total_tokens FROM serving.merged_view GROUP BY model ORDER BY total_tokens DESC"}]},
    {"id":3,"type":"stat","title":"Dead-letter events","gridPos":{"x":18,"y":0,"w":6,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":100}]}}},"options":{"colorMode":"value","graphMode":"area"},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT COALESCE(count(*), 0) AS dead_letters FROM serving.dead_letter"}]},
    {"id":4,"type":"gauge","title":"Budget utilization","gridPos":{"x":0,"y":8,"w":8,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":150,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":80},{"color":"red","value":100}]}}},"options":{"showThresholdLabels":true,"showThresholdMarkers":true},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT team_id, pct_used FROM serving.budget_status ORDER BY team_id"}]},
    {"id":5,"type":"timeseries","title":"Lambda boundary: batch vs speed","gridPos":{"x":8,"y":8,"w":8,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"currencyUSD","custom":{"stacking":{"mode":"normal"}}}},"targets":[{"format":"time_series","rawQuery":true,"rawSql":"SELECT window_start AS time, layer, SUM(cost) AS cost FROM serving.merged_view WHERE $__timeFilter(window_start) GROUP BY window_start, layer ORDER BY window_start"}]},
    {"id":6,"type":"table","title":"Dedup audit","gridPos":{"x":16,"y":8,"w":8,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT run_at, layer, raw_count, after_dedup_count, dropped_count FROM serving.dedup_stats ORDER BY run_at DESC LIMIT 20"}]},
    {"id":7,"type":"stat","title":"STATEFUL: cumulative stream cost","gridPos":{"x":0,"y":16,"w":8,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT COALESCE(SUM(total_cost),0) AS stream_total FROM serving.speed_cumulative"}]},
    {"id":8,"type":"table","title":"STATEFUL: alert transitions","gridPos":{"x":8,"y":16,"w":16,"h":8},"datasource":{"type":"postgres","uid":"ai-bill-pg"},"targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT alert_ts, team_id, threshold, pct_used, total_cost FROM serving.speed_alerts ORDER BY alert_ts DESC LIMIT 20"}]}
  ]
}